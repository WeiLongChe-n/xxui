{
  "name": "vela-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Vela UI - 轻量、可定制的移动端组件库",
  "scripts": {
    "dev": "vitepress dev docs --port 5173",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "vitepress preview docs --port 4173",
    "docs:build:gitee": "node scripts/build-docs.mjs vela-ui",
    "deploy:gitee": "node scripts/deploy-gitee.mjs",
    "build": "vite build --config packages/mobile-ui/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p packages/mobile-ui/tsconfig.json"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "china-area-data": "^5.0.1",
    "puppeteer-core": "^25.16.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0",
    "vitepress": "^1.6.3",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.9.7"
}
