{
  "name": "xxui-mobile",
  "version": "0.3.4",
  "description": "XXUI - 轻量、可定制的 Vue 3 移动端组件库，支持多主题与暗色模式",
  "keywords": [
    "vue",
    "vue3",
    "mobile",
    "ui",
    "component-library",
    "vant",
    "theme",
    "dark-mode",
    "typescript"
  ],
  "homepage": "https://weilongche-n.github.io/xxui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeiLongChe-n/xxui.git",
    "directory": "packages/mobile-ui"
  },
  "bugs": {
    "url": "https://github.com/WeiLongChe-n/xxui/issues"
  },
  "author": "chenweilong",
  "license": "MIT",
  "main": "./dist/xxui.umd.js",
  "module": "./dist/xxui.mjs",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/xxui.css",
  "unpkg": "./dist/xxui.umd.js",
  "jsdelivr": "./dist/xxui.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/xxui.mjs",
      "require": "./dist/xxui.umd.js",
      "default": "./dist/xxui.umd.js"
    },
    "./style.css": "./dist/xxui.css",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
